@using Uni_Attendance.Models
@model Project
@{
    ViewData["Title"] = "Project Details";
    var members = ViewBag.ProjectMembers as List<TeamMember> ?? new List<TeamMember>();
}

<div class="page-heading">
    <div>
        <a asp-controller="Projects" asp-action="Index" class="text-secondary text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Projects
        </a>
        <h2 class="mt-3">@Model.Name</h2>
        <p class="text-secondary">Project overview and information.</p>
    </div>

    <a asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit Project
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h5>Project Overview</h5>
            <p class="text-secondary mt-3">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </p>

            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Project Status</small>
                    <p><span class="status-badge @StatusBadge(Model.Status)">@Model.Status</span></p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Project ID</small>
                    <p>#PR-@Model.Id.ToString("000")</p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Priority</small>
                    <p><span class="priority-badge @PriorityBadge(Model.Priority)">@Model.Priority</span></p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Start Date</small>
                    <p>@Model.StartDate?.ToString("dd MMMM yyyy")</p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Deadline</small>
                    <p>@Model.Deadline?.ToString("dd MMMM yyyy")</p>
                </div>
            </div>
        </div>

        <div class="content-card">
            <h5>Project Progress</h5>
            <div class="d-flex justify-content-between mt-4 mb-2">
                <span class="text-secondary">Overall Completion</span>
                <strong>@Model.Progress%</strong>
            </div>
            <div class="progress">
                <div class="progress-bar" style="width:@Model.Progress%"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h5>Project Team</h5>
            @if (!members.Any())
            {
                <p class="text-secondary mt-4 mb-0">No members assigned yet.</p>
            }

            @foreach (var member in members)
            {
                <div class="d-flex align-items-center gap-3 mt-3">
                    <div class="task-avatar">@Initials(member.FullName)</div>
                    <div>
                        <strong>@member.FullName</strong>
                        <small class="d-block text-secondary">@member.Role</small>
                    </div>
                </div>
            }
        </div>

        <div class="content-card">
            <h5>Quick Actions</h5>
            <a asp-controller="Projects" asp-action="Kanban" class="btn btn-outline-primary w-100 mt-3">
                <i class="bi bi-kanban"></i> Open Kanban Board
            </a>
            <a asp-controller="Tasks" asp-action="Create" class="btn btn-outline-secondary w-100 mt-2">
                <i class="bi bi-plus-lg"></i> Add Task
            </a>
        </div>
    </div>
</div>

@functions {
    static string StatusBadge(string status) => status switch
    {
        "Completed" => "status-done",
        "Planning" => "status-todo",
        "On Hold" => "status-inactive",
        _ => "status-in-progress"
    };

    static string PriorityBadge(string priority) => priority switch
    {
        "High" => "priority-high",
        "Low" => "priority-low",
        _ => "priority-medium"
    };

    static string Initials(string name) => string.Join(string.Empty,
        name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0]).Take(2));
}
